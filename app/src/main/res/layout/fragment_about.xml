<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alpha_bg"
    android:fillViewport="true"
    android:padding="@dimen/space_4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/alpha_card_margin_bottom"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="@dimen/alpha_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ABOUT"
                style="@style/AlphaSectionLabel" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:text="Alpha Control v2.0"
                android:textAppearance="@style/TextAppearance.Alpha.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:lineSpacingExtra="4dp"
                android:text="Gabungan 3 modul:\n- Alpha v1 (io/vm/thermal/net/gpu/devfreq)\n- Uperf Game Turbo (thread/cgroup + AsoulOpt, tanpa freq)\n- fas-rs (frame-aware scheduler, pemegang governor/freq)\n\nCredit upstream: Matt Yang & yinwanxi (Uperf), shadow3 & shadow3aaa (fas-rs)."
                android:textAppearance="@style/TextAppearance.Alpha.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:lineSpacingExtra="4dp"
                android:text="Whitelist Alpha Control di Battery Lab agar floating tetap aktif setelah sistem membersihkan aplikasi."
                android:textAppearance="@style/TextAppearance.Alpha.Caption" />

            <Button
                android:id="@+id/btnBatteryLab"
                style="@style/Widget.Alpha.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:text="BUKA BATTERY LAB" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/alpha_card_margin_bottom"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="@dimen/alpha_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MODULE STATUS"
                style="@style/AlphaSectionLabel" />

            <TextView
                android:id="@+id/tvModule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="Module: ..."
                android:textAppearance="@style/TextAppearance.Alpha.MonoSmall" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnRescan"
                    style="@style/Widget.Alpha.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CARI ULANG MODULE" />

                <Button
                    android:id="@+id/btnRefresh"
                    style="@style/Widget.Alpha.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_2"
                    android:text="REFRESH" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>