<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alpha_bg"
    android:fillViewport="true"
    android:padding="@dimen/space_4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header with banner -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="@dimen/space_1"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/ivHomeBanner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/banner" />

            <View
                android:id="@+id/vHomeScrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/banner_scrim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_4">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ALPHA CONTROL"
                        android:textAppearance="@style/TextAppearance.Alpha.Headline" />

                    <TextView
                        android:id="@+id/tvSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="V2.0 · FUSION"
                        android:textAppearance="@style/TextAppearance.Alpha.MonoSmall" />
                </LinearLayout>

                <View
                    android:id="@+id/dotRoot"
                    android:layout_width="@dimen/alpha_dot_glow"
                    android:layout_height="@dimen/alpha_dot_glow"
                    android:background="@drawable/dot_accent" />
            </LinearLayout>
        </FrameLayout>

        <!-- Profile selector (segmented) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:background="@drawable/seg_bg"
            android:orientation="horizontal"
            android:padding="@dimen/alpha_seg_padding"
            android:weightSum="3">

            <Button
                android:id="@+id/segBattery"
                style="@style/Widget.Alpha.Button.Segment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BATTERY" />

            <Button
                android:id="@+id/segBalanced"
                style="@style/Widget.Alpha.Button.Segment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BALANCED" />

            <Button
                android:id="@+id/segPerformance"
                style="@style/Widget.Alpha.Button.Segment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PERF" />
        </LinearLayout>

        <!-- Current Profile Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/alpha_card_margin_bottom"
            android:layout_marginTop="@dimen/space_3"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="@dimen/alpha_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CURRENT PROFILE"
                style="@style/AlphaSectionLabel" />

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/space_3"
                android:paddingTop="@dimen/space_2"
                android:text="--"
                android:textAppearance="@style/TextAppearance.Alpha.Display" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/seg_bg"
                android:orientation="horizontal"
                android:padding="@dimen/alpha_seg_padding"
                android:weightSum="3">

                <Button
                    android:id="@+id/btnProfileBattery"
                    style="@style/Widget.Alpha.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="BATTERY" />

                <Button
                    android:id="@+id/btnProfileBalanced"
                    style="@style/Widget.Alpha.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="BALANCED" />

                <Button
                    android:id="@+id/btnProfilePerformance"
                    style="@style/Widget.Alpha.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PERF" />
            </LinearLayout>
        </LinearLayout>

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/alpha_card_margin_bottom"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="@dimen/alpha_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STATUS"
                style="@style/AlphaSectionLabel" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="Root: ... | Module: ..."
                android:textAppearance="@style/TextAppearance.Alpha.Body" />

            <Button
                android:id="@+id/btnFloating"
                style="@style/Widget.Alpha.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:text="Tampilkan Floating" />
        </LinearLayout>

        <!-- Quick Actions Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/alpha_card_margin_bottom"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="@dimen/alpha_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="QUICK ACTIONS"
                style="@style/AlphaSectionLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnRefresh"
                    style="@style/Widget.Alpha.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="REFRESH" />

                <Button
                    android:id="@+id/btnRescan"
                    style="@style/Widget.Alpha.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_2"
                    android:text="CARI ULANG MODULE" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>