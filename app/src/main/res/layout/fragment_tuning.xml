<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alpha_bg"
    android:fillViewport="true"
    android:padding="@dimen/space_4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Render Backend -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/alpha_card_margin_bottom"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="@dimen/alpha_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RENDER BACKEND"
                style="@style/AlphaSectionLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/spRender"
                    style="@style/Widget.Alpha.Spinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnRenderApply"
                    style="@style/Widget.Alpha.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:text="APPLY" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRenderStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="Aktif: --"
                android:textAppearance="@style/TextAppearance.Alpha.MonoSmall" />
        </LinearLayout>

        <!-- Tuning Log -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/alpha_card_margin_bottom"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="@dimen/alpha_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TUNING LOG (preview 5 baris)"
                style="@style/AlphaSectionLabel" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:layoutAnimation="@anim/layout_animation_log"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tvLogEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="Belum ada entri."
                android:textAppearance="@style/TextAppearance.Alpha.Body" />

            <Button
                android:id="@+id/btnLogAll"
                style="@style/Widget.Alpha.Button.Tertiary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="LIHAT SEMUA LOG" />
        </LinearLayout>

        <!-- Device Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/alpha_card_margin_bottom"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="@dimen/alpha_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DEVICE INFO"
                style="@style/AlphaSectionLabel" />

            <TextView
                android:id="@+id/tvDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:lineSpacingExtra="4dp"
                android:text="--"
                android:textAppearance="@style/TextAppearance.Alpha.MonoSmall" />

            <Button
                android:id="@+id/btnRedetect"
                style="@style/Widget.Alpha.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:text="DETEKSI ULANG" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>