<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg"
    android:orientation="vertical"
    android:padding="@dimen/space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGameLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Game Label"
                android:textAppearance="@style/TextAppearance.Alpha.Body" />

            <TextView
                android:id="@+id/tvGamePkg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="com.example.game"
                android:textAppearance="@style/TextAppearance.Alpha.MonoSmall" />
        </LinearLayout>

        <Button
            android:id="@+id/btnGameProfile"
            style="@style/Widget.Alpha.Button.Segment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_2"
            android:text="BALANCED" />

        <Button
            android:id="@+id/btnGameRemove"
            style="@style/Widget.Alpha.Button.Tertiary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HAPUS"
            android:textColor="@color/alpha_accent"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>