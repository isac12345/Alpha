<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alpha_bg"
    android:fillViewport="true"
    android:padding="@dimen/space_4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Background Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/alpha_card_margin_bottom"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="@dimen/alpha_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BACKGROUND KUSTOM"
                style="@style/AlphaSectionLabel" />

            <!-- Preview -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="@dimen/space_2"
                android:background="@color/alpha_dark2"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/ivBgPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/banner" />

                <View
                    android:id="@+id/vBgScrim"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/banner_scrim" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnPickBackground"
                    style="@style/Widget.Alpha.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PILIH GAMBAR DARI GALERI" />

                <Button
                    android:id="@+id/btnDefaultBackground"
                    style="@style/Widget.Alpha.Button.Tertiary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_2"
                    android:text="PAKAI BANNER DEFAULT" />
            </LinearLayout>

            <!-- Mode: Fill / Fit -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:text="MODE TAMPILAN"
                style="@style/AlphaSectionLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnModeFill"
                    style="@style/Widget.Alpha.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="FILL (Crop)" />

                <Button
                    android:id="@+id/btnModeFit"
                    style="@style/Widget.Alpha.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_2"
                    android:text="FIT (Full)" />
            </LinearLayout>

            <!-- Transparency -->
            <TextView
                android:id="@+id/tvBgAlphaLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:text="Transparansi background: 100%"
                android:textAppearance="@style/TextAppearance.Alpha.Caption" />

            <SeekBar
                android:id="@+id/seekBackgroundAlpha"
                style="@style/Widget.Alpha.SeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:max="100"
                android:progress="100" />
        </LinearLayout>

        <!-- Resolution -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/alpha_card_margin_bottom"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="@dimen/alpha_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RESOLUSI"
                style="@style/AlphaSectionLabel" />

            <TextView
                android:id="@+id/tvResolutionPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="Resolusi: membaca..."
                android:textAppearance="@style/TextAppearance.Alpha.MonoSmall" />

            <TextView
                android:id="@+id/tvResolutionActive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resolusi aktif saat ini: —"
                android:textAppearance="@style/TextAppearance.Alpha.MonoSmall" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="horizontal"
                android:weightSum="5">

                <Button
                    android:id="@+id/res60"
                    style="@style/Widget.Alpha.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="60%" />

                <Button
                    android:id="@+id/res70"
                    style="@style/Widget.Alpha.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="70%" />

                <Button
                    android:id="@+id/res80"
                    style="@style/Widget.Alpha.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="80%" />

                <Button
                    android:id="@+id/res90"
                    style="@style/Widget.Alpha.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="90%" />

                <Button
                    android:id="@+id/res100"
                    style="@style/Widget.Alpha.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="100%" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnApplyResolution"
                    style="@style/Widget.Alpha.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="APPLY RES" />

                <Button
                    android:id="@+id/btnResetResolution"
                    style="@style/Widget.Alpha.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_2"
                    android:text="RESET NATIVE" />
            </LinearLayout>
        </LinearLayout>

        <!-- Floating Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/alpha_card_margin_bottom"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="@dimen/alpha_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FLOATING PROFIL"
                style="@style/AlphaSectionLabel" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="Ukuran Floating"
                android:textAppearance="@style/TextAppearance.Alpha.Body" />

            <TextView
                android:id="@+id/tvFloatingSizeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="Ukuran: 100%"
                android:textAppearance="@style/TextAppearance.Alpha.Caption" />

            <SeekBar
                android:id="@+id/seekFloatingSize"
                style="@style/Widget.Alpha.SeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:max="90"
                android:progress="40" />

            <Button
                android:id="@+id/btnFloatingShow"
                style="@style/Widget.Alpha.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:text="TAMPILKAN FLOATING" />
        </LinearLayout>

        <!-- Tools -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/alpha_card_margin_bottom"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="@dimen/alpha_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TOOLS"
                style="@style/AlphaSectionLabel" />

            <Button
                android:id="@+id/btnDexopt"
                style="@style/Widget.Alpha.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="DEXOPT APP" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="NOTIFIKASI PROFIL"
                    android:textAppearance="@style/TextAppearance.Alpha.Body" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swNotifEnabled"
                    style="@style/Widget.Alpha.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AUTO-START SAAT BOOT"
                    android:textAppearance="@style/TextAppearance.Alpha.Body" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swAutostart"
                    style="@style/Widget.Alpha.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>