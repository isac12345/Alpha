<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/alpha_dark3" />
            <corners android:radius="@dimen/alpha_field_radius" />
            <stroke android:width="1dp" android:color="@color/alpha_accent" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/alpha_dark2" />
            <corners android:radius="@dimen/alpha_field_radius" />
            <stroke android:width="1.5dp" android:color="@color/alpha_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/alpha_dark2" />
            <corners android:radius="@dimen/alpha_field_radius" />
            <stroke android:width="1dp" android:color="@color/alpha_line" />
        </shape>
    </item>
</selector>