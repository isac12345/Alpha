    <application android:allowBackup="false" android:appComponentFactory="androidx.core.app.CoreComponentFactory" android:debuggable="false" android:extractNativeLibs="false" android:icon="@drawable/ic_launcher_src" android:label="Alpha Control" android:name="com.alphabubble.AlphaApp" android:roundIcon="@drawable/ic_launcher_src" android:theme="@style/Theme.AlphaBubble">
