<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected state -->
    <item android:state_selected="true">
        <shape>
            <solid android:color="#3a3a3c" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#f4f2ee" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#2a2a2c" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#87878a" />
        </shape>
    </item>
    <!-- Default state -->
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#3a3a3c" />
        </shape>
    </item>
</selector>